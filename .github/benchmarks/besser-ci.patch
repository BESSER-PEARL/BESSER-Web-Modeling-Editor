@@ -0,0 +1,36 @@
+"""Allow the Python test matrix to skip PRs that only change release notes."""
+
+import os
+import re
+import subprocess
+
+
+RELEASE_NOTE = re.compile(rb"docs/source/releases/v[0-9]+/v[0-9]+\.[0-9]+\.[0-9]+\.rst")
+
+
+def git(*args):
+    return subprocess.check_output(["git", *args], stderr=subprocess.DEVNULL)
+
+
+def release_notes_only(merge_sha, pr_head_sha):
+    if not merge_sha or not pr_head_sha:
+        return False
+    try:
+        revision = git("rev-list", "--parents", "-n", "1", "HEAD").decode().split()
+        if len(revision) != 3 or revision[0] != merge_sha or revision[2] != pr_head_sha:
+            return False
+        # Report both sides of a rename so moving code into docs still runs tests.
+        paths = git(
+            "diff", "--name-only", "--no-renames", "--ignore-submodules=none",
+            "-z", revision[1], revision[0],
+        )
+    except subprocess.CalledProcessError:
+        return False
+    return bool(paths) and all(RELEASE_NOTE.fullmatch(path) for path in paths.split(b"\0")[:-1])
+
+
+if __name__ == "__main__":
+    skip = release_notes_only(os.environ.get("GITHUB_SHA"), os.environ.get("PR_HEAD_SHA"))
+    print("Versioned release notes only. The docs build covers this change." if skip else "Run full tests.")
+    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as output:
+        print(f"release_notes_only={str(skip).lower()}", file=output)
