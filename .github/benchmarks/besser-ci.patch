@@ -0,0 +1,58 @@
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+
+SCRIPT = Path(__file__).resolve().parents[2] / ".github/scripts/check_test_scope.py"
+RELEASE_NOTE = "docs/source/releases/v8/v8.10.1.rst"
+CODE = "besser/example.py"
+
+
+@pytest.mark.parametrize(
+    ("changed", "wrong_head", "rename_code", "expected"),
+    [
+        ([RELEASE_NOTE], False, False, "true"),
+        ([RELEASE_NOTE], True, False, "false"),
+        ([RELEASE_NOTE, CODE], False, False, "false"),
+        (["docs/source/spec_driven_agent/tools.rst"], False, False, "false"),
+        ([], False, False, "false"),
+        ([], False, True, "false"),
+    ],
+)
+def test_release_note_exemption(tmp_path, changed, wrong_head, rename_code, expected):
+    def git(*args):
+        return subprocess.check_output(["git", *args], cwd=tmp_path, text=True).strip()
+
+    git("init", "-q", "-b", "base")
+    git("config", "user.name", "CI test")
+    git("config", "user.email", "ci@example.invalid")
+    code = tmp_path / CODE
+    code.parent.mkdir()
+    code.write_text("original", encoding="utf-8")
+    git("add", CODE)
+    git("commit", "-qm", "base")
+    git("switch", "-qc", "pr")
+    if rename_code:
+        (tmp_path / RELEASE_NOTE).parent.mkdir(parents=True)
+        git("mv", CODE, RELEASE_NOTE)
+    for name in changed:
+        path = tmp_path / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("changed", encoding="utf-8")
+    git("add", ".")
+    git("commit", "-qm", "pull request", "--allow-empty")
+    head = git("rev-parse", "HEAD")
+    git("switch", "-q", "base")
+    git("merge", "-q", "--no-ff", "--no-edit", "pr")
+    result = tmp_path / "scope"
+    env = {
+        **os.environ,
+        "GITHUB_OUTPUT": str(result),
+        "GITHUB_SHA": git("rev-parse", "HEAD"),
+        "PR_HEAD_SHA": "0" * 40 if wrong_head else head,
+    }
+    subprocess.run([sys.executable, SCRIPT], cwd=tmp_path, env=env, check=True)
+    assert result.read_text(encoding="utf-8") == f"release_notes_only={expected}\n"
