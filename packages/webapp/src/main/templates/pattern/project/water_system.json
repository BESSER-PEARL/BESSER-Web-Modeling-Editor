              "method_5x8gr4jxi_mtt55qr5_ybs": {
                "id": "method_5x8gr4jxi_mtt55qr5_ybs",
                "name": "+ updateLevel()",
                "type": "ClassMethod",
                "owner": "class_m6h92qlvq_mtt55qr5_7zn",
                "bounds": {
                  "x": -452.8999710083008,
                  "y": 67.50001907348633,
                  "width": 219,
                  "height": 25
                },
                "code": "def updateLevel(self):\n    \"\"\"\n    Update tank water level based on connected incoming\n    and outgoing water flows.\n    \"\"\"\n\n    inflow = 0.0\n    outflow = 0.0\n\n    # Sum incoming flows\n    for flow in (self.inFlows or []):\n        inflow += float(flow.flowRateLiters or 0.0)\n\n    # Sum outgoing flows\n    for flow in (self.outFlows or []):\n        outflow += float(flow.flowRateLiters or 0.0)\n\n    # Update tank level\n    self.levelLiters = (\n        (self.levelLiters or 0.0)\n        + inflow\n        - outflow\n    )\n\n    # Clamp between 0 and capacity\n    self.levelLiters = max(\n        0.0,\n        min(self.capacityLiters or 0.0, self.levelLiters)\n    )",
                "visibility": "public",
                "attributeType": "float",
                "implementationType": "code",
                "stateMachineId": "",
